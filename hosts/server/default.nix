{ config, lib, pkgs, inputs, ... }:

{
  imports = [
    ./hardware-configuration.nix # generated by nixos-anywhere during install
  ];

  # Bootloader Setup (UEFI)
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  # Timezone
  time.timeZone = "Europe/Amsterdam";

  # User Account
  users.users.raoul = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    openssh.authorizedKeys.keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIE8lzfP2kfpHKTNeRthtM+gr/YBgDPL9VI8UA03A6gmd raoul@home"
    ];
  };

  # SSH: key-only login
  services.openssh = {
    enable = true;
    settings = {
      PasswordAuthentication = true;
      PermitRootLogin = "no";
    };
  };

  modules.system = {
    core-tools.enable = true;
    maintenance.enable = true; # weekly GC, boot entry limit
    netbird.enable = true;     # reach the server from anywhere via your NetBird network
  };

  nix.settings = {
    experimental-features = [ "nix-command" "flakes" ];
    # Lets you push builds from your desktop/laptops as raoul
    trusted-users = [ "raoul" ];
  };

  # Set to the release of the ISO you install with, never change it afterwards
  system.stateVersion = "26.05";
}
