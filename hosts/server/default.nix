{ config, lib, pkgs, inputs, ... }:

{
  imports = [
    inputs.disko.nixosModules.disko
    ./hardware-configuration.nix # generated by nixos-anywhere during install
    ./disk-config.nix
  ];

  # Bootloader Setup (UEFI)
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  # Timezone
  time.timeZone = "Europe/Amsterdam";

  # User Account
  users.users.raoul = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    # Generate with: mkpasswd -m yescrypt   (plain password goes into Bitwarden)
    hashedPassword = "REPLACE_WITH_HASH";
    openssh.authorizedKeys.keys = [
      # cat ~/.ssh/id_ed25519.pub on each machine you want to deploy from
      "ssh-ed25519 AAAA... home"
      "ssh-ed25519 AAAA... thinkpad"
    ];
  };

  # SSH: key-only login
  services.openssh = {
    enable = true;
    settings = {
      PasswordAuthentication = false;
      PermitRootLogin = "no";
    };
  };

  modules.system = {
    core-tools.enable = true;
    maintenance.enable = true; # weekly GC, boot entry limit
    netbird.enable = true;     # reach the server from anywhere via your NetBird network
  };

  nix.settings = {
    experimental-features = [ "nix-command" "flakes" ];
    # Lets you push builds from your desktop/laptops as raoul
    trusted-users = [ "raoul" ];
  };

  # Set to the release of the ISO you install with, never change it afterwards
  system.stateVersion = "26.05";
}
